{
    "env": {
      "es6": true,
      "node": true
    },
    "extends": ["standard", "prettier", "plugin:prettier/recommended"],
    "plugins": ["prettier"],
    "rules": {
      "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ],
      "camelcase": "off"
    }
  }
  